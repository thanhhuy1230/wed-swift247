# ===== Google Search Console API (tùy chọn) – lấy từ khóa THẬT bài viết đang hiển thị trên Google =====
# Dán nguyên nội dung file JSON của service account trên 1 dòng (giữ dấu nháy đơn bao ngoài). Xem hướng dẫn trong README.
# GSC_CREDENTIALS='{"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# GSC_SITE=sc-domain:yourdomain.vn

# ===== MySQL – website đọc/ghi dữ liệu trong database thay cho file JSON (xem README mục "Dùng MySQL") =====
# Xóa (hoặc thêm # trước) dòng MYSQL_DATABASE để quay về dùng file JSON trong data/.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=huy102210
MYSQL_DATABASE=swift247
# Số giây website kiểm tra thay đổi bạn sửa trực tiếp trong MySQL (Workbench…)
MYSQL_REFRESH_SECONDS=5
